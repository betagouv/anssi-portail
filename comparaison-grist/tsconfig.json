{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "rootDir": ".",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "allowJs": false,
    "moduleResolution": "bundler",
    "types": ["node"]
  }
}
