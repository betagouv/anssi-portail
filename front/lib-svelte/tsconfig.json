{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "allowArbitraryExtensions": true,
    "paths": {
      "@abonnement-infolettre/*": ["./src/abonnement-infolettre/*"],
      "@accueil/*": ["./src/accueil/*"],
      "@article/*": ["./src/article/*"],
      "@avis-utilisateur/*": ["./src/avis-utilisateur/*"],
      "@badge-agent-anssi/*": ["./src/badge-agent-anssi/*"],
      "@catalogue/*": ["./src/catalogue/*"],
      "@centre-aide/*": ["./src/centre-aide/*"],
      "@connexion/*": ["./src/connexion/*"],
      "@conseils-cyber/*": ["./src/conseils-cyber/*"],
      "@contacts/*": ["./src/contacts/*"],
      "@creation-compte/*": ["./src/creation-compte/*"],
      "@demande-aide-mon-aide-cyber/*": ["./src/demande-aide-mon-aide-cyber/*"],
      "@directives/*": ["./src/directives/*"],
      "@favoris/*": ["./src/favoris/*"],
      "@financements/*": ["./src/financements/*"],
      "@gestion-guides/*": ["./src/gestion-guides/*"],
      "@graphiques/*": ["./src/graphiques/*"],
      "@identification/*": ["./src/identification/*"],
      "@integration-webc/*": ["./src/integration-webc/*"],
      "@interlocuteurs/*": ["./src/interlocuteurs/*"],
      "@maintenance/*": ["./src/maintenance/*"],
      "@mini-tests/*": ["./src/mini-tests/*"],
      "@navigation/*": ["./src/navigation/*"],
      "@nis2/*": ["./src/nis2/*"],
      "@nis2-simulateur/*": ["./src/nis2-simulateur/*"],
      "@niveaux-maturite/*": ["./src/niveaux-maturite/*"],
      "@observatoire/*": ["./src/observatoire/*"],
      "@outils/*": ["./src/outils/*"],
      "@parcours/*": ["./src/parcours/*"],
      "@parcours-securisation/*": ["./src/parcours-securisation/*"],
      "@passerelles/*": ["./src/passerelles/*"],
      "@plateforme/*": ["./src/plateforme/*.client", "./src/plateforme/*.serveur"],
      "@protection/*": ["./src/protection/*"],
      "@sante/*": ["./src/sante/*"],
      "@statistiques/*": ["./src/statistiques/*"],
      "@stores/*": ["./src/stores/*"],
      "@tableau-de-bord/*": ["./src/tableau-de-bord/*"],
      "@test-maturite/*": ["./src/test-maturite/*"],
      "@ui/*": ["./src/ui/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "vite.config.ts",
    "vite.config.ssr.ts",
    "vite.config.webc.ts"
  ]
}
