{
  "name": "@anssi-portail/svelte",
  "private": true,
  "version": "1.0.0",
  "description": "Partie svelte pour le catalogue du portail de l’ANSSI",
  "type": "module",
  "scripts": {
    "build": "npm-run-all --parallel build:client build:serveur",
    "build:client": "vite build",
    "build:serveur": "vite build --ssr --config vite.config.ssr.ts",
    "build:dev": "vite build --watch --mode=development",
    "dev": "vite dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "pretest": "npm-run-all --parallel typecheck lint",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit && svelte-check --fail-on-warnings",
    "watch": "npm-run-all --parallel dev watch:serveur",
    "watch:serveur": "vite build --ssr --config vite.config.ssr.ts --watch"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/qrcode": "^1.5.6",
    "eslint-plugin-svelte": "^3.15.2",
    "globals": "^17.0.0",
    "npm-run-all2": "^9.0.0",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "^4.0.0",
    "sass": "^1.102.0",
    "svelte": "catalog:",
    "svelte-check": "^4.4.5",
    "tslib": "^2.8.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.7",
    "vitest-localstorage-mock": "^0.1.2"
  },
  "dependencies": {
    "@sentry/browser": "^10.70.0",
    "@sentry/vite-plugin": "^5.4.0",
    "axios": "catalog:",
    "dompurify": "^3.4.11",
    "entities": "catalog:",
    "isomorphic-dompurify": "catalog:",
    "qrcode": "^1.5.4"
  },
  "main": "svelte.config.js",
  "directories": {
    "test": "test"
  }
}
