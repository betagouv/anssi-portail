{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["github-actions", "npm", "nvm", "bundler"],
  "useBaseBranchConfig": "merge",
  "commitMessagePrefix": "[RENOVATE]",
  "prHourlyLimit": 10,
  "prConcurrentLimit": 4,
  "packageRules": [
    {
      "description": "@sentry/node et @sentry/browser restent en version majeure 10",
      "matchPackageNames": ["@sentry/node", "@sentry/browser"],
      "allowedVersions": "<11.0.0"
    },
    {
      "description": "@types/node reste aligné sur la version majeure 24 définie dans .nvmrc",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25.0.0"
    },
    {
      "description": "Regroupe les mises à jour des dépendances AWS SDK utilisées pour S3",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@aws-sdk/client-s3", "@aws-sdk/credential-providers"],
      "groupName": "AWS SDK S3"
    },
    {
      "description": "lockFileMaintenance",
      "matchUpdateTypes": ["pin", "digest", "patch", "minor", "major", "lockFileMaintenance"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": ["@lab-anssi/ui-kit"],
      "enabled": false
    }
  ]
}
