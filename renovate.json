{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["github-actions", "npm", "nvm", "bundler"],
  "useBaseBranchConfig": "merge",
  "commitMessagePrefix": "[RENOVATE]",
  "prHourlyLimit": 10,
  "prConcurrentLimit": 4,
  "packageRules": [
    {
      "description": "Version 11 supportant à minina un backend Sentry en version 26.4.2. Backend actuel: 25.9.0",
      "matchPackageNames": ["@sentry/node", "@sentry/browser", "@sentry/vite-plugin"],
      "allowedVersions": "<11.0.0"
    },
    {
      "description": "@types/node reste aligné sur la version majeure 26 définie dans .nvmrc",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<27.0.0"
    },
    {
      "description": "Regroupe les mises à jour des dépendances AWS SDK utilisées pour S3",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@aws-sdk/client-s3", "@aws-sdk/credential-providers"],
      "groupName": "AWS SDK"
    },
    {
      "description": "Regroupe les mises à jour des dépendances Sentry",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@sentry/node", "@sentry/browser"],
      "groupName": "Sentry"
    },
    {
      "description": "Regroupe les mises à jour typescript-eslint",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript-eslint", "@typescript-eslint/utils"],
      "groupName": "typescript-eslint"
    },
    {
      "description": "lockFileMaintenance",
      "matchUpdateTypes": ["pin", "digest", "patch", "minor", "major", "lockFileMaintenance"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Regroupe les montées de version patch de npm dans une seule PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "groupName": "npm - mises à jour patch",
      "schedule": ["* * * * 1,4"]
    },
    {
      "matchPackageNames": ["@lab-anssi/ui-kit"],
      "enabled": false
    }
  ]
}
