{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "allowJs": false,
    "paths": {
      "@api/*": ["./src/api/*"],
      "@bus/*": ["./src/bus/*"],
      "@infra/*": ["./src/infra/*"],
      "@metier/*": ["./src/metier/*"]
    }
  }
}
