{
  "name": "@anssi-portail/msc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm typecheck && pnpm lint",
    "watch": "node --watch-path=src --watch-path=pages.json --watch-path=vite.config.ts node_modules/vite/bin/vite.js build --mode development"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "eslint-plugin-svelte": "^3.15.2",
    "globals": "^17.0.0",
    "svelte": "catalog:",
    "svelte-check": "^4.4.5",
    "vite": "^8.2.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@types/node": "catalog:",
    "typescript": "^6.0.3"
  },
  "exports": {
    "./handler": {
      "types": "./handler.d.ts",
      "default": "./dist/handler.js"
    },
    "./contexte": {
      "types": "./contexte.d.ts"
    },
    "./pages.json": "./pages.json"
  }
}
